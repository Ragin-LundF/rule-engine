# fraud-detection.rule
#
# Demonstrates:
#   - regex operator (case-sensitive and with ignoreCase)
#   - between operator on integer count field
#   - equals (case-sensitive and ignoreCase)
#   - startsWith / endsWith
#   - gt / lt / gte / lte
#   - not operator
#   - nested bracket groups
#   - else (one condition, both outcomes)
#
# Schema: full-schema.yaml

# ── IBAN format validation (regex) ──────────────────────────────────────────

# Written with an `else` rather than as `not iban regex …`: the region test appears once, in its positive
# form, and both outcomes hang off it. The negated single-branch version left the domestic case unstated,
# so nothing recorded that a counterparty *had* been checked and found local.

rule "counterparty-region" {
  description "A counterparty IBAN from outside the DACH region is flagged; a DACH one is recorded as domestic."
  when
    iban regex "^(DE|AT|CH)"

  then
    label "domestic-counterparty"

  else
    flag "foreign-iban"
    alert "non-dach-counterparty"
}

rule "synthetic-iban" {
  description "The IBAN's account number is all zeroes, which marks a test or synthetic account."
  when
    iban regex "^[A-Z]{2}[0-9]{2}0{10,}"

  then
    flag "synthetic"
    alert "possible-test-transaction"
}

rule "fraud-keyword-purpose" {
  description "The purpose text contains a known fraud keyword, matched case-insensitively."
  when
    purpose regex "(?i)(phishing|fraud|scam|money laundering|hacking|spam)"

  then
    label "fraud"
    alert "fraud-keyword-detected"
    reject "compliance-block"
}

rule "suspicious-counterparty-name" {
  description "The counterparty name reads as a shell company; the same match written with the ignoreCase modifier."
  when
    counterparty regex "[Ss]hell [Cc]ompan(y|ies)" ignoreCase

  then
    flag "suspicious-entity"
}

# ── Numeric range / comparison rules ────────────────────────────────────────

rule "structuring-suspicion" {
  description "Repeated payments sitting just below the reporting threshold, the classic structuring pattern."
  when
    count between 5 20
    and amount between 8000 9999

  then
    flag "structuring"
    alert "aml-structuring-suspicion"
}

rule "high-value-outgoing" {
  description "A single outgoing payment above the 10000 unit reporting threshold."
  when
    amount < -10000

  then
    flag "high-value"
    alert "payment-above-threshold"
}

rule "zero-amount-probe" {
  description "A booking of exactly zero, which is typically an account-probing transaction."
  when
    amount equals 0

  then
    flag "probe"
    alert "zero-amount-detected"
}

# ── Complex combined rules ───────────────────────────────────────────────────

rule "foreign-high-value" {
  description "A substantial outgoing payment to an IBAN outside the DACH region."
  when
    (not iban regex "^(DE|AT|CH)")
    and amount < -5000

  then
    label "fraud"
    alert "foreign-high-value-outgoing"
    reject "compliance-block"
}

rule "internal-transfer-anomaly" {
  description "A booking marked as an internal transfer, but for an amount far larger than one usually is."
  when
    purpose endsWith "intern" ignoreCase
    and (amount > 50000 or amount < -50000)

  then
    flag "anomaly"
    alert "internal-transfer-large-amount"
}
