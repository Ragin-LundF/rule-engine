# sepa-classification.rule
#
# Demonstrates:
#   - equals (case-sensitive, via normalizer)
#   - in operator (list membership)
#   - startsWith / endsWith (case-sensitive and ignoreCase)
#   - contains (case-sensitive via normalizer)
#   - gte / lte / gt / lt
#   - not operator
#   - bracket groups + combined operators
#
# Schema: full-schema.yaml
# Note: sepaCode field has normalizers [trim, uppercase], so values are
#       uppercased before comparison. The purposeNorm field has [trim, lowercase,
#       german_umlaut_fold] applied.

# ── SEPA code-based classification ──────────────────────────────────────────

rule "direct-debit" {
  description "The SEPA purpose code identifies the booking as a direct debit."
  when
    sepaCode in ["DMCT", "DRNL", "PRCT"]

  then
    label "direct-debit"
    category "banking"
}

rule "card-payment" {
  description "The SEPA purpose code identifies the booking as a card payment."
  when
    sepaCode in ["CCRD", "DCRD", "PMNT"]

  then
    label "card"
    category "payment"
}

rule "salary-credit" {
  description "An incoming booking carrying the SEPA salary code."
  when
    sepaCode equals "SALA"
    and amount > 0

  then
    label "salary"
    category "income"
}

# ── Purpose text classification ──────────────────────────────────────────────

rule "rent-payment" {
  description "The normalized purpose text names rent or a lease, for an amount that plausibly is one."
  when
    (purposeNorm contains "miete"
    or purposeNorm contains "rent"
    or purposeNorm contains "pacht")
    and amount >= 300

  then
    label "rent"
    category "housing"
}

rule "utility-bill" {
  description "The purpose text starts with the name of a known energy or utility provider."
  when
    (purpose startsWith "Stadtwerke" ignoreCase
    or purpose startsWith "Gaswerk" ignoreCase
    or purpose startsWith "EnBW" ignoreCase
    or purpose startsWith "E.ON" ignoreCase
    or purpose startsWith "Vattenfall" ignoreCase)

  then
    label "utility"
    category "household"
}

rule "insurance-payment" {
  description "An outgoing booking whose purpose text ends in \"Versicherung\"."
  when
    purpose endsWith "Versicherung" ignoreCase
    and amount < 0

  then
    label "insurance"
    category "insurance"
}

rule "streaming-subscription" {
  description "The counterparty is one of the known streaming providers, matched exactly."
  when
    (counterparty equals "NETFLIX" ignoreCase
    or counterparty equals "Spotify AB" ignoreCase
    or counterparty equals "Amazon Digital" ignoreCase
    or counterparty equals "Disney+" ignoreCase)

  then
    label "streaming"
    category "entertainment"
}

# ── Negative amount rules ────────────────────────────────────────────────────

rule "outgoing-transfer" {
  description "Money left the account by some route other than a direct debit."
  when
    amount < 0
    and not sepaCode in ["DMCT", "DRNL"]

  then
    label "outgoing"
}

rule "large-outgoing" {
  description "More than 1000 units left the account on a booking that is not a salary."
  when
    amount < -1000
    and not sepaCode equals "SALA"

  then
    flag "large-outgoing"
    score 80
}

# ── Tags-based classification (string_set) ───────────────────────────────────

rule "premium-customer-transfer" {
  description "An incoming booking for a customer tagged both premium and verified."
  when
    tags containsAll ["premium", "verified"]
    and amount > 0

  then
    label "premium-credit"
    score 100
}

rule "flagged-customer" {
  description "The customer carries a compliance tag, so the booking is blocked and reported."
  when
    tags containsAny ["blocked", "sanctioned", "aml-watch"]

  then
    flag "compliance"
    alert "flagged-customer-transaction"
    reject "aml-block"
}
