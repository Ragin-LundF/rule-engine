# 3. Route risk — aggregates over the `checkpoints` collection.
#
# Schema: schema.yaml

rule "route-on-time" {
  description "The shipment moved through the network without any significant hold-up."
  when
    max(checkpoints.delayMinutes) < 60
    and avg(checkpoints.delayMinutes) < 30

  then
    assessment "route:on-time"
    reason "no-checkpoint-delayed-by-an-hour"
}

rule "route-delayed" {
  description "A single checkpoint held the shipment for two hours or more."
  when
    max(checkpoints.delayMinutes) >= 120

  then
    assessment "route:delayed"
    reason "a-checkpoint-was-delayed-by-two-hours-or-more"
}

rule "tracking-gap" {
  description "A checkpoint was passed without a scan, so the tracking history has a gap."
  when
    count(checkpoints[scanned == false]) > 0

  then
    assessment "tracking:gap"
    reason "a-checkpoint-was-not-scanned"
}

# Ordering by a member, ascending. `take(..., 1)` after an ordering is how a rule reads the single
# best or worst element of a collection — there is no `first`/`last` function, and none is needed.
rule "worst-checkpoint-delay" {
  description "The most delayed checkpoint on the route held the shipment up by more than two hours."
  when
    sum(take(sortBy(checkpoints, "delayMinutes", desc), 1).delayMinutes) > 120

  then
    assessment "route:severely-delayed"
    reason "worst-checkpoint-delayed-by-more-than-two-hours"
}
