# 1. Delivery quality — read straight from the nested `shipment` record.
#
# Every condition here is a plain comparison on a path declared through nested `fields:` blocks.
# Schema: schema.yaml

rule "premium-service-promise" {
  description "Gold-tier customers shipping on an express service get the premium service assessment."
  when
    shipment.customer.tier equals "gold"
    and shipment.service contains "express"

  then
    assessment "service:premium"
    reason "gold-customer-on-express-service"
}

rule "transit-within-promise" {
  description "A shipment delivered in two days or less meets the transit promise."
  when
    shipment.transitDays <= 2

  then
    assessment "transit:green"
    reason "delivered-within-two-days"
}

rule "transit-over-promise" {
  description "A shipment that spends more than two days in transit misses the promise."
  when
    shipment.transitDays > 2

  then
    assessment "transit:red"
    reason "more-than-two-days-in-transit"
}

rule "insurance-required" {
  description "A valuable shipment needs a cover note. The country is normalized before it is compared, so \"de\" and \" DE \" are treated the same."
  when
    shipment.declaredValue between 1000 25000
    and shipment.customer.country equals "DE"

  then
    assessment "insurance:required"
    reason "declared-value-above-one-thousand"
}

rule "pickup-inside-planning-window" {
  description "The shipment was picked up inside the current planning window."
  when
    shipment.pickedUpAt >= "01.03.2026"

  then
    assessment "pickup:in-window"
    reason "picked-up-in-the-current-planning-window"
}
