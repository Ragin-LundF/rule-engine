# The stock check comes first and ends the run.
#
# "Must not be recommended" only holds if nothing downstream gets the chance to recommend it. None of
# the rules below look at `stock`, so without the `stop` an out-of-stock luxury item would come back
# both excluded *and* recommended to the premium shelf, and the caller would have to reconcile that.
# `stop` states the intent in the rule instead of leaving it to the consumer.

rule "out-of-stock-exclusion" {
  description "The product is out of stock, so it is excluded and nothing else is recommended for it."
  when
    stock equals 0

  then
    exclude "out-of-stock"
    stop
}

rule "luxury-item" {
  description "An expensive, highly rated product with a substantial review count."
  when
    price >= 500
    and rating >= 4.5
    and reviewCount >= 50

  then
    badge "luxury"
    recommend "premium-shelf"
    boost 90
}

rule "high-rated-affordable" {
  description "An affordable product with an outstanding rating and many reviews."
  when
    rating >= 4.7
    and price between 20 150
    and reviewCount >= 100

  then
    badge "top-rated"
    recommend "best-value"
    boost 80
}
