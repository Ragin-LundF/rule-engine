rule "electronics-featured" {
  description "A well-rated new or trending electronics product for the homepage."
  when
    category equals "electronics"
    and rating >= 4.0
    and tags containsAny ["new-arrival", "trending"]

  then
    recommend "electronics-homepage"
    badge "trending"
    boost 70
}

rule "seasonal-promotion" {
  description "A seasonal or sale product that is still in stock."
  when
    tags containsAny ["seasonal", "holiday", "sale"]
    and stock >= 10

  then
    recommend "promotional-banner"
    badge "on-sale"
}

rule "books-staff-pick" {
  description "An exceptionally well-reviewed book worth featuring as a staff pick."
  when
    category equals "books"
    and rating >= 4.8
    and reviewCount >= 200

  then
    badge "staff-pick"
    recommend "featured-books"
    boost 85
}
