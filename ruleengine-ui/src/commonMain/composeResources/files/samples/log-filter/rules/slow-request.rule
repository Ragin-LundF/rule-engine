rule "critically-slow-request" {
  description "A production request took longer than five seconds."
  when
    responseTime > 5000
    and environment equals "production"

  then
    tag "performance-critical"
    alert "sre-team"
    escalate "p1"
}

rule "slow-request" {
  description "A request took between two and five seconds."
  when
    responseTime between 2000 5000

  then
    tag "slow"
    route "performance-channel"
}

rule "server-error-slow" {
  description "The request both failed with a server error and was slow."
  when
    statusCode >= 500
    and responseTime > 1000

  then
    tag "error-and-slow"
    alert "backend-team"
}
