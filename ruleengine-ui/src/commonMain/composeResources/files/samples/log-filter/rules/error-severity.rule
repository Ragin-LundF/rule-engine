rule "critical-error" {
  description "A critical or fatal log entry that pages the on-call engineer."
  when
    level equals "CRITICAL"
    or level equals "FATAL"

  then
    tag "critical"
    alert "ops-pagerduty"
    route "dead-letter"
}

rule "error-log" {
  description "A genuine error entry that is not suppressed and not from a test."
  when
    level equals "ERROR"
    and not tags containsAny ["suppressed", "test"]

  then
    tag "error"
    route "error-channel"
}

rule "warning-production" {
  description "A warning raised in the production environment."
  when
    level equals "WARN"
    and environment equals "production"

  then
    tag "warning-prod"
    route "monitoring-channel"
}
