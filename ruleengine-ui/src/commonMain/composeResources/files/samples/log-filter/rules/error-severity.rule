# Severity-based routing. The suppression rule sits first and ends the run.
#
# "Discarded" has to mean discarded. The rules in slow-request.rule key off `responseTime` and never look
# at `level`, so without the `stop` a suppressed DEBUG entry could still be tagged "performance-critical"
# and page the SRE team — the entry would be both dropped and escalated. Stopping here is what makes the
# suppression final, and it only works because this file is listed first in manifest.yaml.

rule "noisy-debug-suppression" {
  description "Debug and trace entries are discarded in production and staging, and nothing further is assessed."
  when
    level in ["DEBUG", "TRACE"]
    and environment in ["production", "staging"]

  then
    suppress
    stop
}

rule "critical-error" {
  description "A critical or fatal log entry that pages the on-call engineer."
  when
    level equals "CRITICAL"
    or level equals "FATAL"

  then
    tag "critical"
    alert "ops-pagerduty"
    route "dead-letter"
}

rule "error-log" {
  description "A genuine error entry that is not suppressed and not from a test."
  when
    level equals "ERROR"
    and not tags containsAny ["suppressed", "test"]

  then
    tag "error"
    route "error-channel"
}

rule "warning-production" {
  description "A warning raised in the production environment."
  when
    level equals "WARN"
    and environment equals "production"

  then
    tag "warning-prod"
    route "monitoring-channel"
}
