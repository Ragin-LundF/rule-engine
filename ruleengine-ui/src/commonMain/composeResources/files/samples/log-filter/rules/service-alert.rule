rule "payment-service-error" {
  description "The payment service reported an error or worse."
  when
    service equals "payment-service"
    and level in ["ERROR", "CRITICAL", "FATAL"]

  then
    tag "payment-error"
    alert "payments-oncall"
    escalate "p1"
}

rule "auth-service-failure" {
  description "The auth service rejected a request or a token expired."
  when
    service equals "auth-service"
    and (message contains "unauthorized"
    or message contains "token expired"
    or statusCode equals 401)

  then
    tag "auth-failure"
    alert "security-team"
}
