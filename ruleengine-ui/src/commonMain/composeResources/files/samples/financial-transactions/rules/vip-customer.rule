rule "vip-high-volume" {
  description "A verified or premium customer moved a large amount."
  when
    amount >= 10000
    and tags containsAny ["verified", "premium"]

  then
    label "vip"
    notify "relationship-manager"
}

rule "vip-frequent-trader" {
  description "An active, verified customer with a high transaction count."
  when
    count >= 20
    and tags containsAll ["active", "verified"]

  then
    label "frequent-trader"
    score 90
}

rule "preferred-customer" {
  description "A highly scored customer with no blocking or restricting tag."
  when
    score >= 75
    and not tags containsAny ["blocked", "restricted"]

  then
    label "preferred"
    notify "offers-team"
}
