rule "rent-payment" {
  description "A payment of at least 300 whose purpose mentions rent or an apartment."
  when
    (purpose contains "rent"
    or purpose contains "apartment")
    and amount >= 300

  then
    label "rent"
    score 10
}

rule "utility-bill" {
  description "A moderate payment whose purpose names a utility such as electricity, gas, water or internet."
  when
    (purpose contains "strom"
    or purpose contains "electricity"
    or purpose contains "gas"
    or purpose contains "water"
    or purpose contains "internet")
    and amount between 20 500

  then
    label "utility"
    score 5
}
