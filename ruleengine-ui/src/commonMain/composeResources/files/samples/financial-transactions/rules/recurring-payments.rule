# Boolean and date conditions.
# Both are editable in Builder mode: a boolean field offers a true/false dropdown,
# a date field takes quoted ISO dates.

rule "recurring-subscription" {
  description "A small recurring payment is treated as a subscription."
  when
    recurring equals true
    amount between 5 100

  then
    label "subscription"
    score 5
}

rule "one-off-large-payment" {
  description "A large payment that is not part of a recurring series."
  when
    recurring equals false
    and amount > 5000

  then
    flag "one-off-large"
    score 40
}

rule "current-year-booking" {
  description "The transaction was booked in the 2024 fiscal year."
  when
    bookingDate between "2024-01-01" "2024-12-31"

  then
    label "fiscal-2024"
}

rule "backdated-entry" {
  description "The booking date is far in the past, which needs a manual check."
  when
    bookingDate < "2020-01-01"

  then
    flag "backdated"
    alert "manual-review-required"
}
