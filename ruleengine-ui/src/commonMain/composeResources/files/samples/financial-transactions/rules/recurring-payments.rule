# Boolean and date conditions.
# Both are editable in Builder mode: a boolean field offers a true/false dropdown,
# a date field takes quoted ISO dates.

# The plainest case for an `else` branch: one boolean, two labels. Every payment gets exactly one of
# them, and the boundary between them exists in one place. Written as two rules it would be
# `recurring equals true` and `recurring equals false` — the same decision stated twice, where nothing
# stops a later edit from leaving both true or neither.
#
# The two rules after it are *not* a pair like this: they add an amount band on top of the flag, so a
# payment can match neither.

rule "payment-cadence" {
  description "Marks every payment as either part of a recurring series or a one-off."
  when
    recurring equals true

  then
    label "recurring"

  else
    label "one-off"
}

rule "recurring-subscription" {
  description "A small recurring payment is treated as a subscription."
  when
    recurring equals true
    amount between 5 100

  then
    label "subscription"
    score 5
}

rule "one-off-large-payment" {
  description "A large payment that is not part of a recurring series."
  when
    recurring equals false
    and amount > 5000

  then
    flag "one-off-large"
    score 40
}

rule "current-year-booking" {
  description "The transaction was booked in the 2024 fiscal year."
  when
    bookingDate between "2024-01-01" "2024-12-31"

  then
    label "fiscal-2024"
}

rule "backdated-entry" {
  description "The booking date is far in the past, which needs a manual check."
  when
    bookingDate < "2020-01-01"

  then
    flag "backdated"
    alert "manual-review-required"
}
