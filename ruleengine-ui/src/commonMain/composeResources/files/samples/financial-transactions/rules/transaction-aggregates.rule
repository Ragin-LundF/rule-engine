# Aggregate rules over the `transactions` collection.
# These are editable in Builder mode: each condition is a comparison row whose
# sides can be a field, a value, an aggregate, or a calculation.

rule "high-total-volume" {
  description "The transactions in this record add up to a high total volume."
  when
    sum(transactions.amount) > 10000

  then
    flag "high-total-volume"
    score 60
}

rule "risk-share-too-high" {
  description "More than three percent of the incoming volume is flagged as risk."
  when
    sum(transactions[label == "risk"].amount) > sum(transactions[amount > 0].amount) * 0.03

  then
    flag "high-risk-ratio"
    alert "manual-review-required"
    score 80
}

rule "many-small-transfers" {
  description "A large number of very small transfers with a low average amount."
  when
    count(transactions[amount < 100]) > 20
    and avg(transactions.amount) < 50

  then
    flag "micro-transfer-pattern"
    alert "potential-structuring"
    score 70
}

rule "foreign-counterparty-volume" {
  description "Part of the volume is non-domestic and at least one transfer is substantial."
  when
    not sum(transactions[label == "domestic"].amount) >= sum(transactions.amount)
    and max(transactions.amount) > 2500

  then
    flag "foreign-counterparty-volume"
    score 50
}

# Ordering a collection — `sortBy` decides *which* elements a following slice keeps.
#
# The ordering is part of the path, so `take(..., 3)` narrows the ordered list and `.amount`
# projects off what is left. `sortBy(take(transactions, 3), "amount", desc)` would instead order
# whichever three transactions arrived first, which answers a different question.
#
# The `count(transactions) > 3` guard matters: with three or fewer, the three largest are all
# of them and the rule would fire on every small statement.
rule "largest-transactions-dominate" {
  description "The three largest transactions account for more than half of everything moved."
  when
    count(transactions) > 3
    and sum(take(sortBy(transactions, "amount", desc), 3).amount) > sum(transactions.amount) * 0.5

  then
    flag "concentrated_volume"
    score 40
}

# Ordering a set of values. A `string_set` has no members to name, so the two-argument form orders
# the values themselves — which is what makes the published list stable enough to compare or report.
rule "tags-in-order" {
  description "Publishes the transaction's tags alphabetically, so downstream output is stable."
  when
    count(tags) > 0

  then
    set orderedTags = sortBy(tags, asc)
}
