rule "admin-full-access" {
  description "Administrators have unrestricted access and every action is logged."
  when
    role equals "admin"

  then
    allow "full-access"
    log "admin-action"
}

rule "readonly-restriction" {
  description "A viewer may not perform any write operation."
  when
    role equals "viewer"
    and method in ["POST", "PUT", "PATCH", "DELETE"]

  then
    deny "read-only-role"
    log "write-attempt-by-viewer"
}

rule "service-account-api" {
  description "Service accounts may call the internal API at a high rate limit."
  when
    role equals "service-account"
    and path startsWith "/api/internal/"

  then
    allow "internal-api"
    rateLimit 1000
}

# Ordering a set of values — a `string_set` declares no members, so the two-argument form of
# `sortBy` orders the values themselves. Publishing them in a fixed order is what makes an audit
# line comparable between two requests that carry the same tags in a different order.
rule "audit-tags-in-order" {
  description "Publishes the request's tags alphabetically, so audit output is stable between requests."
  when
    count(tags) > 0

  then
    set orderedTags = sortBy(tags, asc)
}
