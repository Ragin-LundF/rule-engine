rule "internal-network-allow" {
  description "Requests from the internal network ranges are allowed with a generous rate limit."
  when
    ip startsWith "10."
    or ip startsWith "192.168."
    or ip startsWith "172.16."

  then
    allow "internal-network"
    rateLimit 10000
}

rule "blocklisted-ip" {
  description "The source address is on the block list or has been reported for abuse."
  when
    tags containsAny ["blocklisted", "abuse-reported"]

  then
    deny "ip-blocklist"
    log "blocked-request"
}

rule "suspicious-ip-rate-limit" {
  description "Traffic from a high-volume or Tor exit address is throttled unless it is an admin."
  when
    tags containsAny ["high-traffic", "tor-exit"]
    and not role equals "admin"

  then
    rateLimit 10
    log "suspicious-source"
}
